Helpers.GetEquipmentRarity = function(equipment)
    local s, r = pcall(function()
        if equipment.Ores then
            local mostUsedOre = DataEquipments:GetMostUsedOre(equipment.Ores)
            if mostUsedOre and OreRarityMap[mostUsedOre] then
                return OreRarityMap[mostUsedOre]
            end
        end
        return "Common"
    end)
    return s and r or "Common"
end

