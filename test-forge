-- Rune selection helper - handles both runeId and display names
Helpers.IsRuneSelected = function(runeId)
    local selectedRunes = getgenv().SelectedRunesToSell or {}
    local nameToId = getgenv().RuneNameToId or {}
    local idToName = getgenv().RuneIdToName or {}
    for _, selected in pairs(selectedRunes) do
        if runeId == selected or nameToId[selected] == runeId or idToName[runeId] == selected then
            return true
        end
    end
    return false
end

-- Consolidated rune helper functions into Helpers table
Helpers.RuneHasExtraTraits = function(runeInstance)
    if runeInstance and runeInstance.Traits and type(runeInstance.Traits) == "table" then
        local count = 0
        for _ in pairs(runeInstance.Traits) do count = count + 1 end
        return count > 1
    end
    return false
end

Helpers.GetRuneHighestRollPercent = function(runeInstance)
    local highestPercent = 0
    if runeInstance and runeInstance.Traits and runeInstance.Traits[1] then
        local traitData = runeInstance.Traits[1]
        local traitId, tier = traitData.Id, traitData.Tier or 1
        local traitPool = DataRunes and DataRunes.TraitPool and DataRunes.TraitPool[traitId]
        
        for key, val in pairs(traitData) do
            if key ~= "Id" and key ~= "Tier" and type(val) == "number" then
                local isFixed = traitPool and traitPool.Stats and traitPool.Stats[key] and traitPool.Stats[key][tier]
                    and traitPool.Stats[key][tier].Min == traitPool.Stats[key][tier].Max
                if not isFixed and val >= 0 and val <= 1 then
                    highestPercent = math.max(highestPercent, val * 100)
                end
            end
        end
    end
    return highestPercent
end

Helpers.ShouldProtectRune = function(runeInstance, favoritesCache)
    -- Check if favorited (by GUID)
    if getgenv().ProtectFavoritedRunes and runeInstance.GUID then
        if Helpers.IsItemFavorited(runeInstance.GUID, favoritesCache) then
            return true, "favorited"
        end
    end
    if getgenv().ProtectMultiTraitRunes and Helpers.RuneHasExtraTraits(runeInstance) then
        return true, "has extra traits"
    end
    if getgenv().ProtectHighRollRunes then
        local threshold = getgenv().RuneRollThreshold or 80
        local highestRoll = Helpers.GetRuneHighestRollPercent(runeInstance)
        if highestRoll >= threshold then
            return true, "high-roll (" .. math.floor(highestRoll) .. "%)"
        end
    end
    return false, nil
end

