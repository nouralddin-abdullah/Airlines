    return s and p or 0
end

local function DoAutoSell()
    local soldItems = 0
    local totalValue = 0
    
    -- Sell Weapons/Armors (direct remote - no NPC needed)
    local shouldSellWeapons = getgenv().AutoSellWeapons and (
        #getgenv().SelectedWeaponsToSell > 0 or
        (getgenv().SellWeaponsByRarity and #getgenv().SelectedWeaponRarities > 0) or
        getgenv().SellWeaponsBelowPrice
    )
    
    if shouldSellWeapons then
        local inventory = Helpers.GetPlayerInventory()
        if inventory and inventory.Equipments then
            local basket = {}
            local equipCount = 0
            
            for _, equipment in pairs(inventory.Equipments) do
                if equipment.GUID and equipment.Type then
                    local shouldSell = false
                    
                    -- OR Logic: sell if ANY condition is met
                    
                    -- Check if weapon type is selected
                    if Helpers.IsSelected(equipment.Type, getgenv().SelectedWeaponsToSell) then
                        shouldSell = true
                    end
                    
                    -- Check rarity filter if enabled (OR condition)
                    if not shouldSell and getgenv().SellWeaponsByRarity and #getgenv().SelectedWeaponRarities > 0 then
                        local rarity = Helpers.GetEquipmentRarity(equipment)
                        if Helpers.IsSelected(rarity, getgenv().SelectedWeaponRarities) then
                            shouldSell = true
                        end
                    end
                    
                    -- Check price threshold if enabled (OR condition)
                    if not shouldSell and getgenv().SellWeaponsBelowPrice then
                        local price = Helpers.CalculateEquipmentPrice(equipment)
                        if price < getgenv().WeaponPriceThreshold then
                            shouldSell = true
                            totalValue = totalValue + price
                        end
                    end
                    
                    if shouldSell then
                        basket[equipment.GUID] = true
                        equipCount = equipCount + 1
                    end
                end
            end
            
            -- Send sell request using direct Sell remote
            if next(basket) then
                local success, result = pcall(function()
                    return SellEquipmentRemote:InvokeServer(basket, true)
                end)
                
                if success then
                    soldItems = soldItems + equipCount
                else
                    WindUI:Notify({
                        Title = "Equipment Sell Failed",
                        Content = "Could not sell equipment: " .. tostring(result),
                        Duration = 3,
                        Icon = "alert-circle",
                    })
                end
            end
        end
    end
    
    -- Sell Ores (direct remote - no NPC needed)
    local shouldSellOres = getgenv().AutoSellOres and (
        #getgenv().SelectedOresToSell > 0 or
        (getgenv().SellOresByRarity and #getgenv().SelectedOreRarities > 0)
    )
    
    if shouldSellOres then
        local inventory = Helpers.GetPlayerInventory()
        local favorites = getgenv().ProtectFavoritedOres and Helpers.GetPlayerFavorites() or {}
        
        if inventory then
            local basket = {}
            local protectedOreCount = 0
            
            -- Ores are stored directly as keys in the inventory (not in a sub-table)
            for itemName, amount in pairs(inventory) do
                -- Convert amount to number in case it's stored as string
                local numAmount = tonumber(amount)
                if numAmount and numAmount > 0 then
                    local shouldSell = false
                    
                    -- OR Logic: sell if ore is specifically selected OR matches rarity filter
                    
                    -- Check if this specific ore is selected
                    if Helpers.IsSelected(itemName, getgenv().SelectedOresToSell) then
                        shouldSell = true
                    end
                    
                    -- Check rarity filter (OR condition - sell if matches rarity)
                    if not shouldSell and getgenv().SellOresByRarity and #getgenv().SelectedOreRarities > 0 then
                        local rarity = OreRarityData[itemName]
                        if rarity and Helpers.IsSelected(rarity, getgenv().SelectedOreRarities) then
                            shouldSell = true
                        end
                    end
                    
                    if shouldSell then
                        -- Check if ore is favorited
                        if getgenv().ProtectFavoritedOres and Helpers.IsItemFavorited(itemName, favorites) then
                            shouldSell = false
                            protectedOreCount = protectedOreCount + 1
                        end
                    end
                    
                    if shouldSell then
                        local amountToSell = numAmount
                        
                        -- Limit sell quantity if enabled (sell up to X amount)
                        if getgenv().LimitOreQuantity then
                            local maxSellAmount = tonumber(getgenv().OreQuantityLimit) or 100
                            if numAmount > maxSellAmount then
                                amountToSell = maxSellAmount
                            end
                        end
                        
                        if amountToSell > 0 then
                            basket[itemName] = amountToSell
                            soldItems = soldItems + 1
                        end
                    end
                end
            end
            
            -- Send sell request if we have ores (direct remote - no NPC needed)
            if next(basket) then
                local success = pcall(function()
                    SellMiscRemote:InvokeServer(basket)
                end)
                
                if not success then
                    soldItems = 0
                    WindUI:Notify({
                        Title = "Ore Sell Failed",
                        Content = "Failed to sell ores.",
                        Duration = 3,
                        Icon = "alert-circle",
                    })
                end
            end
            
            -- Notify about protected ores (if any)
            if protectedOreCount > 0 then
                WindUI:Notify({
                    Title = "Ores Protected",
                    Content = protectedOreCount .. " ore type(s) protected (favorited).",
                    Duration = 2,
                    Icon = "star",
                })
            end
        end
    end
    
    -- Sell Runes (uses direct SellMisc remote - no NPC needed)
    local shouldSellRunes = getgenv().AutoSellRunes and #(getgenv().SelectedRunesToSell or {}) > 0
    
    if shouldSellRunes then
        local inventory = Helpers.GetPlayerInventory()
        local favorites = getgenv().ProtectFavoritedRunes and Helpers.GetPlayerFavorites() or {}
        
        if inventory and inventory.Misc then
            local basket = {}
            local protectedCount = 0
            local runeCount = 0
            
            for _, item in pairs(inventory.Misc) do
                if item.GUID and item.Id then
                    -- Check if this is a rune by looking up in _G.ItemTypes
                    local isRune = false
                    pcall(function()
                        if _G.ItemTypes and _G.ItemTypes[item.Id] then
                            isRune = _G.ItemTypes[item.Id][1] == "Rune"
                        end
                    end)
                    
                    -- Alternative rune detection: check if Id exists in DataRunes.Runes
                    if not isRune and DataRunes and DataRunes.Runes then
                        isRune = DataRunes.Runes[item.Id] ~= nil
                    end
                    
                    if isRune then
                        -- Check if this rune type is selected for selling
                        local isSelected = Helpers.IsRuneSelected(item.Id)
                        
                        if isSelected then
                            -- Check if rune should be protected
                            local shouldProtect, protectReason = Helpers.ShouldProtectRune(item, favorites)
                            
                            if shouldProtect then
                                protectedCount = protectedCount + 1
                            else
                                -- Add rune GUID to basket (runes use GUID, amount is always 1)
                                basket[item.GUID] = 1
                                runeCount = runeCount + 1
                            end
                        end
                    end
                end
            end
            
            -- Send sell request using direct SellMisc remote
            if next(basket) then
                local success, result = pcall(function()
                    return SellMiscRemote:InvokeServer(basket)
                end)
                
                if success then
                    soldItems = soldItems + runeCount
                else
                    WindUI:Notify({
                        Title = "Rune Sell Failed",
                        Content = "Could not sell runes: " .. tostring(result),
                        Duration = 3,
                        Icon = "alert-circle",
                    })
                end
            end
            
            -- Notify about protected runes (if any)
            if protectedCount > 0 then
                WindUI:Notify({
                    Title = "Runes Protected",
                    Content = protectedCount .. " rune(s) protected from selling.",
                    Duration = 2,
                    Icon = "shield",
                })
            end
        end
    end
    
    if soldItems > 0 then
        WindUI:Notify({
            Title = "Auto Sell Complete",
            Content = "Sold " .. soldItems .. " items!",
            Duration = 3,
            Icon = "dollar-sign",
        })
    end
end

