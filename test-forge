-- Function to check if stash is full
local function IsStashFull()
    local success, result = pcall(function()
        local stashCapacityLabel = PlayerGui:FindFirstChild("Menu")
        if stashCapacityLabel then
            stashCapacityLabel = stashCapacityLabel:FindFirstChild("Frame")
            if stashCapacityLabel then
                stashCapacityLabel = stashCapacityLabel:FindFirstChild("Frame")
                if stashCapacityLabel then
                    stashCapacityLabel = stashCapacityLabel:FindFirstChild("Menus")
                    if stashCapacityLabel then
                        stashCapacityLabel = stashCapacityLabel:FindFirstChild("Stash")
                        if stashCapacityLabel then
                            stashCapacityLabel = stashCapacityLabel:FindFirstChild("Capacity")
                            if stashCapacityLabel and stashCapacityLabel:IsA("TextLabel") then
                                local text = stashCapacityLabel.ContentText or stashCapacityLabel.Text
                                -- Parse "Stash Capacity: 7/120" format
                                local current, max = text:match("(%d+)/(%d+)")
                                if current and max then
                                    return tonumber(current) >= tonumber(max)
                                end
                            end
                        end
                    end
                end
            end
        end
        return false
    end)
    if success then
        return result
    end
    return false
end

