-- Check if a rock is being mined by another player using LastHitPlayer/LastHitTime attributes
local function IsRockBeingMined(rock)
    if not rock then return false end
    
    local lastHitPlayer = rock:GetAttribute("LastHitPlayer")
    local lastHitTime = rock:GetAttribute("LastHitTime")
    
    -- If no attributes, rock is free
    if not lastHitPlayer or not lastHitTime then
        return false
    end
    
    -- If we're the last one who hit it, it's fine
    if lastHitPlayer == LocalPlayer.Name then
        return false
    end
    
    -- Check if the last hit was within the timeout period
    local currentTime = workspace:GetServerTimeNow() -- Use server time for accuracy
    local timeSinceHit = currentTime - lastHitTime
    
    if timeSinceHit <= ROCK_OCCUPY_TIMEOUT then
        return true -- Someone else is actively mining
    end
    
    return false -- Last hit was too long ago, consider it free
end

-- Check if rock is in our blacklist (from "already mining" notification)
local function IsRockBlacklisted(rock)
    if not rock then return false end
    
    local blacklistTime = occupiedRocks[rock]
    if not blacklistTime then return false end
    
    -- Check if blacklist has expired
    if tick() - blacklistTime > OCCUPIED_ROCK_BLACKLIST_TIME then
        occupiedRocks[rock] = nil
        return false
    end
    
    return true
end

-- Clean up old blacklisted rocks periodically
local function CleanupOccupiedRocks()
    local now = tick()
    for rock, time in pairs(occupiedRocks) do
        if now - time > OCCUPIED_ROCK_BLACKLIST_TIME then
            occupiedRocks[rock] = nil
        end
    end
end

